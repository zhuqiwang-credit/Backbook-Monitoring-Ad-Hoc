-- DQ Rates & Inventory Rates Weekly Views
--Data Input - Tab: CA DQ WoW Data
With A as(
select
weekofyear(eff_dt) as WOY,
year(eff_dt) as Year_New,
(sum(buck0_bal)+sum(buck1_bal)+sum(buck2_bal)+sum(buck3_bal)+sum(buck4_bal)) as Total_Outstanding,
(sum(buck1_bal)+sum(buck2_bal)+sum(buck3_bal)+sum(buck4_bal)) as DQ_4_Bal,
(sum(buck2_bal)+sum(buck3_bal)+sum(buck4_bal)) as DQ_30_Bal,
sum(buck1_bal) as Bucket_One,
sum(buck2_bal) as Bucket_Two,
sum(buck3_bal) as Bucket_Three,
sum(buck4_bal) as Bucket_Four,
sum(buck5_bal) as Bucket_Five

from
PROD__WORKSPACE__CA.SCRATCH_LOOKER_WORKSPACE.ca_br_ffr_looker_new
where
 merchant not in ('Peloton') and Year(eff_dt) in ('2024','2025','2026')  
 and eff_dt<'2026-08-01'

group by
    1,2)

select
WoY,
Year_New,
    (DQ_4_Bal/Total_Outstanding) as DQ_4_Plus,
    (DQ_30_Bal/Total_Outstanding) as DQ_30_Plus,

    Total_Outstanding,
    Bucket_One,
    Bucket_Two,
    Bucket_Three,
    Bucket_Four,
    (Bucket_One/Total_Outstanding) as Bucket_One,
    (Bucket_Two/Total_Outstanding) as Bucket_Two,
    (Bucket_Three/Total_Outstanding) as Bucket_Three,
    (Bucket_Four/Total_Outstanding) as Bucket_Four
from
    A
order by
    WoY;



