--Weekly Canada Flow Rates (for the actual charts)
--Data Input - Tab: CA FFR Data
select
weekofyear(eff_dt) as WoY,
yearofweek(eff_dt) as Year_New,
(sum(buck_0_1_bal)/sum(NULLIF(buck0_bal_lag30,0))) as FFR0_1,
(sum(buck_1_2_bal)/sum(NULLIF(buck1_bal_lag30,0))) as FFR1_2,
(sum(buck_0_2_bal)/sum(NULLIF(buck0_bal_lag60,0))) as FFR0_2,
(sum(buck_2_3_bal)/sum(NULLIF(buck2_bal_lag30,0))) as FFR2_3,
(sum(buck_3_4_bal)/sum(NULLIF(buck3_bal_lag30,0))) as FFR3_4,
(sum(buck_4_5_bal)/sum(NULLIF(buck4_bal_lag30,0))) as FFR4_5,
(sum(buck_1_5_bal)/sum(NULLIF(buck1_bal_lag120,0))) as FFR1_5,
(sum(buck_0_5_bal)/sum(NULLIF(buck0_bal_lag150,0))) as FFR0_5
from
PROD__WORKSPACE__CA.SCRATCH_LOOKER_WORKSPACE.ca_br_ffr_looker_new
where
Year(eff_dt) in ('2026','2025','2024') and merchant not in ('Peloton') and eff_dt<'2026-08-01' --when running the table, limit year to 2024, otherwise put back 2023
 group by
 1,2
order by
1;


