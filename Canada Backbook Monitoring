--BK rate by vintage
--Data Input Tab: CO Data (A527:C999)
With Total_Loan_Amount as (
select
    date_trunc('month',capture_date) as Capture_Month,
    coalesce(sum(distinct loan_amount),0) as Total_Loan_Amount
from
    PROD__WORKSPACE__CA.SCRATCH_LOOKER_WORKSPACE.ca_br_co_looker_New_Temp
where
    capture_month>='2023-11-01'
group by
1),
Total_CO as (
select
date_trunc('month',capture_date) as Capture_Month,
datediff('month',date_trunc('month',capture_date),date_trunc('month',CO_DATE)) as MOB,
sum(gross_co) as Gross_CO_Rate
from
PROD__WORKSPACE__CA.SCRATCH_LOOKER_WORKSPACE.ca_br_co_looker_New_Temp
where
Capture_Month>='2023-12-01' and CO_DATE is not NULL and CO_DATE<'2026-08-01'
and bk_flag =1
group by
1,2)

select
    to_date(t1.Capture_Month) as Capture_Month,
    t1.MOB,
    (sum(Gross_CO_Rate) over(partition by t1.capture_month order by MOB))/Total_Loan_Amount as Gross_CO_Rate
from
    Total_CO as t1
left join
    TOTAL_LOAN_AMOUNT as t2
on
    t1.capture_Month=t2.Capture_Month;


