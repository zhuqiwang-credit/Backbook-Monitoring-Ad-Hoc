--Charge Off Type and Volume
--Data Input - Tab: CO Data (A1:C94)
select
date_trunc('month',CO_DATE) as CO_Month,
case when BK_FLAG=1 then 'BKO'
when fraud_flag=1 then 'Fraud' else 'Credit' end as CO_Category,
sum(gross_co) as Gross_CO
from
PROD__WORKSPACE__CA.SCRATCH_LOOKER_WORKSPACE.ca_br_co_looker_New_Temp
where
CO_Month>='2024-01-01' and CO_Month<'2026-08-01'--change date as needed
